# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Tarot scene backup snapshots (keep locally, not in git)
mockup/share-assets/tarot_scene/_backup/
mockup/share-assets/tarot_scene/*/_backup/

# Planet textures are large, regeneratable via generate_planet_textures.py
mockup/share-assets/tarot_scene/planet_textures/

# Generated catasterism background source images (variants / bright) — large,
# regeneratable via mockup/generate_*.py, NOT bundled in the app
# (the app ships a curated subset under assets/catasterism-bg/). Local only.
mockup/share-assets/backgrounds_*_variants/
mockup/share-assets/backgrounds_*_bright/

# Downloaded fonts for tools (e.g. Cinzel for make_feature_graphic.py). OFL,
# re-downloadable; avoid committing binaries. Download URL is in the script header.
tools/_fonts_*.ttf
